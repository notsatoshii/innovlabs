---
/** Placeholder subpage: Base layout with the page name as its h1 (sized like an h2), noindex. Phase 4 replaces it. */
import Base from '../layouts/Base.astro';
import { asLocale, t } from '../i18n/utils';
import Section from './Section.astro';

interface Props {
  nameKey: string;
}

const { nameKey } = Astro.props;
const locale = asLocale(Astro.currentLocale);
const name = t(locale, nameKey);
---

<Base title={`${name} · ${t(locale, 'meta.site_name')}`} description={t(locale, 'meta.home.description')} noindex>
  <Section bg="paper" density="sparse">
    <h1>{name}</h1>
  </Section>
</Base>

<style>
  h1 {
    font-size: var(--text-h2);
  }
</style>
