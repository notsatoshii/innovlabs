---
/** Placeholder subpage: Base layout with the page name at h2. Phase 4 replaces it. */
import Base from '../layouts/Base.astro';
import { asLocale, t } from '../i18n/utils';
import Section from './Section.astro';

interface Props {
  nameKey: string;
}

const { nameKey } = Astro.props;
const locale = asLocale(Astro.currentLocale);
const name = t(locale, nameKey);
---

<Base title={`${name} · ${t(locale, 'meta.site_name')}`} description={t(locale, 'meta.home.description')}>
  <Section bg="paper" density="sparse">
    <h2>{name}</h2>
  </Section>
</Base>
