---
/**
 * Sticky top bar: lockup, four links, survey CTA, language toggle.
 * Below 900px the links collapse into a full-screen ink overlay.
 */
import { getRelativeLocaleUrl } from 'astro:i18n';
import { APP_URL } from '../config';
import { t, type Locale } from '../i18n/utils';
import Button from './Button.astro';
import LangToggle from './LangToggle.astro';
import LogoTile from './LogoTile.astro';
import Wordmark from './Wordmark.astro';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;

const LINKS = [
  { key: 'nav.courses', path: 'courses' },
  { key: 'nav.platform', path: 'platform' },
  { key: 'nav.business', path: 'business' },
  { key: 'nav.about', path: 'about' },
];

const links = LINKS.map((link) => ({
  label: t(locale, link.key),
  href: getRelativeLocaleUrl(locale, link.path),
}));
const home = getRelativeLocaleUrl(locale);
---

<header class="nav" data-nav>
  <div class="bar">
    <a class="lockup" href={home} aria-label={t(locale, 'a11y.home_link')}>
      <LogoTile size="2.5rem" shadow="pressed" />
      <Wordmark class="mark" />
    </a>

    <nav class="links" aria-label={t(locale, 'a11y.primary_nav')}>
      {links.map((link) => <a href={link.href}>{link.label}</a>)}
    </nav>

    <div class="tools">
      <Button href={APP_URL} size="sm">{t(locale, 'nav.cta')}</Button>
      <LangToggle locale={locale} />
    </div>

    <button
      class="burger"
      type="button"
      aria-expanded="false"
      aria-controls="mobile-menu"
      data-menu-button
      data-label-open={t(locale, 'a11y.menu_open')}
      data-label-close={t(locale, 'a11y.menu_close')}
    >
      <span class="lines" aria-hidden="true"></span>
      <span class="sr-only" data-menu-label>{t(locale, 'a11y.menu_close')}</span>
    </button>
  </div>

  <div class="overlay" id="mobile-menu" data-menu>
    <nav class="overlay-links" aria-label={t(locale, 'a11y.primary_nav')}>
      {links.map((link) => <a href={link.href}>{link.label}</a>)}
    </nav>
    <div class="overlay-tools">
      <Button href={APP_URL} size="md">{t(locale, 'nav.cta')}</Button>
      <LangToggle locale={locale} />
    </div>
  </div>
</header>

<script>
  const header = document.querySelector<HTMLElement>('[data-nav]');
  const button = header?.querySelector<HTMLButtonElement>('[data-menu-button]');
  const label = button?.querySelector<HTMLElement>('[data-menu-label]');

  if (header && button && label) {
    const setOpen = (open: boolean) => {
      header.toggleAttribute('data-open', open);
      button.setAttribute('aria-expanded', String(open));
      label.textContent = open ? button.dataset.labelClose ?? '' : button.dataset.labelOpen ?? '';
      document.documentElement.style.overflow = open ? 'hidden' : '';
    };

    setOpen(false);
    button.addEventListener('click', () => setOpen(!header.hasAttribute('data-open')));
    document.addEventListener('keydown', (event) => {
      if (event.key === 'Escape') setOpen(false);
    });
    window.matchMedia('(min-width: 900px)').addEventListener('change', (event) => {
      if (event.matches) setOpen(false);
    });
  }
</script>

<style>
  .nav {
    position: sticky;
    top: 0;
    z-index: 10;
    background: var(--paper);
    border-bottom: var(--border);
  }

  .bar {
    display: flex;
    align-items: center;
    gap: var(--gutter);
    height: var(--nav-h);
    max-width: var(--max-width);
    margin-inline: auto;
    padding-inline: var(--gutter);
  }

  .lockup {
    display: inline-flex;
    align-items: center;
    gap: 0.75rem;
    text-decoration: none;
    margin-right: auto;
  }

  .mark {
    font-size: 1.5rem;
  }

  .links {
    display: none;
    gap: var(--gutter);
  }

  .links a {
    font-weight: 700;
    text-decoration: none;
  }

  .links a:hover {
    text-decoration: underline;
    text-decoration-thickness: 3px;
    text-underline-offset: 0.2em;
  }

  .tools {
    display: none;
    align-items: center;
    gap: var(--gutter);
  }

  .burger {
    display: inline-grid;
    place-items: center;
    width: 3rem;
    height: 3rem;
    padding: 0;
    background: var(--white);
    border: var(--border);
    box-shadow: var(--shadow-pressed);
    cursor: pointer;
  }

  .lines {
    display: block;
    width: 1.375rem;
    height: 3px;
    background: var(--ink);
    box-shadow:
      0 -0.45rem 0 var(--ink),
      0 0.45rem 0 var(--ink);
  }

  .overlay {
    position: fixed;
    top: var(--nav-h);
    right: 0;
    bottom: 0;
    left: 0;
    z-index: 9;
    display: flex;
    flex-direction: column;
    gap: var(--space-dense);
    padding: var(--space-dense) var(--gutter);
    overflow-y: auto;
    background: var(--ink);
    color: var(--paper);
    visibility: hidden;
    transform: translateY(-100%);
  }

  .nav[data-open] .overlay {
    visibility: visible;
    transform: translateY(0);
    transition: transform var(--dur-menu) var(--ease);
  }

  .overlay-links {
    display: flex;
    flex-direction: column;
    gap: 0.5em;
  }

  .overlay-links a {
    font-size: var(--text-h2);
    font-weight: 800;
    line-height: 1.1;
    text-decoration: none;
  }

  .overlay-tools {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--gutter);
  }

  @media (min-width: 900px) {
    .links,
    .tools {
      display: flex;
    }

    .burger,
    .overlay {
      display: none;
    }
  }
</style>
