---
/**
 * /business, nav "Companies" (v3): training and development on one page,
 * one inquiry form that posts JSON to the funnel app's /api/inquiry.
 * Section ids match the home router's links (#training, #development).
 */
import { getRelativeLocaleUrl } from 'astro:i18n';
import { INQUIRY_URL } from '../../config';
import { asLocale, t, tList, tRecords } from '../../i18n/utils';
import Button from '../Button.astro';
import Flowchart from '../Flowchart.astro';
import PhotoFrame from '../PhotoFrame.astro';
import Section from '../Section.astro';

const locale = asLocale(Astro.currentLocale);
const formats = tRecords(locale, 'business.training.formats');
const head = tList(locale, 'business.training.table_head');
const work = tRecords(locale, 'business.services.work');
const interests = tRecords(locale, 'business.form.interest_options');
const verticals = tList(locale, 'business.services.verticals');
const studioLink = t(locale, 'business.services.studio_link');
---

<Section bg="paper" density="medium">
  <h1 class="display big">{t(locale, 'business.hero.headline')}</h1>
  <p class="sub">{t(locale, 'business.hero.sub')}</p>
  <div class="jumps">
    <Button href="#training" size="md">{t(locale, 'business.hero.jump_training')}</Button>
    <Button href="#development" size="md" variant="secondary">{t(locale, 'business.hero.jump_services')}</Button>
  </div>
</Section>

<Section bg="white" density="dense" id="training">
  <h2>{t(locale, 'business.training.headline')}</h2>
  <p class="lead">{t(locale, 'business.training.body')}</p>

  <div class="table-wrap">
    <table class="formats">
      <thead>
        <tr>{head.map((h) => <th scope="col">{h}</th>)}</tr>
      </thead>
      <tbody>
        {
          formats.map((f) => (
            <tr>
              <th scope="row">{f.title}</th>
              <td>{f.length}</td>
              <td>{f.group}</td>
              <td>{f.line}</td>
            </tr>
          ))
        }
      </tbody>
    </table>
  </div>
  <p class="it">{t(locale, 'business.training.it')}</p>

  <div class="two">
    <div>
      <h3>{t(locale, 'business.training.outcomes_headline')}</h3>
      <ul class="outcomes">
        {tList(locale, 'business.training.outcomes').map((line) => <li>{line}</li>)}
      </ul>
    </div>
    <div>
      <h3>{t(locale, 'business.training.process_headline')}</h3>
      <div class="process">
        <Flowchart labels={tList(locale, 'business.training.process')} />
      </div>
    </div>
  </div>
</Section>

<Section bg="paper" density="dense" id="development">
  <h2>{t(locale, 'business.services.headline')}</h2>
  <p class="lead">{t(locale, 'business.services.body')}</p>
  <ul class="offer">
    {
      tRecords(locale, 'business.services.offer').map((item) => (
        <li>
          <h3>{item.title}</h3>
          <p>{item.line}</p>
        </li>
      ))
    }
  </ul>
  <p class="method">{t(locale, 'business.services.method')}</p>

  <h3 class="sub-h">{t(locale, 'business.services.verticals_headline')}</h3>
  <ul class="verticals">
    {verticals.map((v) => <li>{v}</li>)}
  </ul>
  <p class="studio">
    {t(locale, 'business.services.studio')}
    <a href={`https://${studioLink}`} rel="noopener">{studioLink}</a>
  </p>

  {
    work.length > 0 && (
      <>
        <h3 class="sub-h">{t(locale, 'business.services.work_headline')}</h3>
        <ul class="work">
          {work.map((w) => (
            <li>
              <span class="display metric">{w.metric}</span>
              <span>{w.line}</span>
            </li>
          ))}
        </ul>
      </>
    )
  }
</Section>

<Section bg="white" density="dense">
  <h2>{t(locale, 'business.team.headline')}</h2>
  <div class="people">
    {
      tRecords(locale, 'business.team.people').map((person, i) => (
        <div class="person">
          <div class="photo">
            <PhotoFrame alt={person.name} initial={person.name.slice(0, 1)} rotate={i % 2 ? 2 : -2} tape={person.name} />
          </div>
          <div>
            <h3>{person.name}</h3>
            <p>{person.credentials}</p>
          </div>
        </div>
      ))
    }
  </div>
</Section>

<Section bg="pink" density="dense" id="inquiry">
  <h2>{t(locale, 'business.form.headline')}</h2>
  <p class="lead">{t(locale, 'business.form.body')}</p>
  <form class="form" method="post" action={INQUIRY_URL} data-inquiry data-endpoint={INQUIRY_URL} data-locale={locale} data-sending={t(locale, 'business.form.sending')} novalidate>
    <label><span>{t(locale, 'business.form.name')}</span><input name="name" type="text" required maxlength="120" autocomplete="name" /></label>
    <label><span>{t(locale, 'business.form.company')}</span><input name="company" type="text" required maxlength="160" autocomplete="organization" /></label>
    <label><span>{t(locale, 'business.form.role')}</span><input name="role" type="text" maxlength="120" autocomplete="organization-title" /></label>
    <label><span>{t(locale, 'business.form.email')}</span><input name="email" type="email" required maxlength="200" autocomplete="email" /></label>
    <label
      ><span>{t(locale, 'business.form.interest')}</span>
      <select name="interest">
        {interests.map((option) => <option value={option.value}>{option.label}</option>)}
      </select>
    </label>
    <label><span>{t(locale, 'business.form.team_size')}</span><input name="team_size" type="text" maxlength="40" /></label>
    <label class="wide"><span>{t(locale, 'business.form.message')}</span><textarea name="message" rows="5" maxlength="4000"></textarea></label>
    <label class="trap" aria-hidden="true"><span>Website</span><input name="website" type="text" tabindex="-1" autocomplete="off" /></label>
    <div class="wide submit">
      <Button size="md" type="submit">{t(locale, 'business.form.submit')}</Button>
      <p class="consent label">
        {t(locale, 'business.form.consent')}
        <a href={getRelativeLocaleUrl(locale, 'privacy')}>{t(locale, 'footer.privacy')}</a>
      </p>
    </div>
    <p class="status failed label" data-failed hidden>{t(locale, 'business.form.failed')}</p>
  </form>
  <div class="sent" data-sent hidden>
    <h3>{t(locale, 'business.form.sent_title')}</h3>
    <p>{t(locale, 'business.form.sent_body')}</p>
  </div>
</Section>

<script>
  const form = document.querySelector<HTMLFormElement>('[data-inquiry]');
  if (form) {
    const endpoint = form.dataset.endpoint ?? '';
    const locale = form.dataset.locale ?? 'ko';
    const failed = form.querySelector<HTMLElement>('[data-failed]');
    const sent = document.querySelector<HTMLElement>('[data-sent]');
    const button = form.querySelector<HTMLButtonElement>('button[type=submit]');
    const idle = button?.textContent ?? '';

    form.addEventListener('submit', async (event) => {
      event.preventDefault();
      if (!form.reportValidity()) return;
      if (failed) failed.hidden = true;
      if (button) {
        button.disabled = true;
        button.textContent = form.dataset.sending ?? idle;
      }
      const data = Object.fromEntries(new FormData(form).entries());
      try {
        const res = await fetch(endpoint, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ ...data, locale }),
        });
        if (!res.ok) throw new Error(String(res.status));
        form.hidden = true;
        if (sent) sent.hidden = false;
      } catch {
        if (failed) failed.hidden = false;
        if (button) {
          button.disabled = false;
          button.textContent = idle;
        }
      }
    });
  }
</script>

<style>
  .big {
    max-width: 14ch;
    font-size: clamp(2.75rem, 6.5vw, 5.5rem);
    text-wrap: pretty;
  }

  .sub,
  .lead {
    max-width: 56ch;
    margin-top: var(--gutter);
    font-size: var(--text-body);
  }

  .lead {
    margin-bottom: var(--space-dense);
  }

  .jumps {
    display: flex;
    flex-wrap: wrap;
    gap: var(--gutter);
    margin-top: var(--space-dense);
  }

  .table-wrap {
    overflow-x: auto;
  }

  .formats {
    width: 100%;
    min-width: 40rem;
    border: var(--border);
    border-collapse: collapse;
    background: var(--paper);
  }

  .formats th,
  .formats td {
    padding: var(--gutter);
    text-align: left;
    vertical-align: top;
    font-size: var(--text-body);
    border-top: var(--border);
  }

  .formats thead th {
    background: var(--ink);
    color: var(--paper);
    border-top: 0;
  }

  .formats th + th,
  .formats td + td,
  .formats th + td {
    border-left: var(--border);
  }

  .formats tbody th {
    font-weight: 700;
    white-space: nowrap;
  }

  .it {
    max-width: 56ch;
    margin-top: var(--gutter);
    padding: var(--gutter);
    background: var(--lime);
    border: var(--border);
    font-size: var(--text-body);
    font-weight: 700;
  }

  .two {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-dense) calc(var(--gutter) * 2);
    margin-top: var(--space-dense);
  }

  .outcomes {
    margin: var(--gutter) 0 0;
    padding-left: 1.2em;
    font-size: var(--text-body);
    font-weight: 700;
  }

  .process {
    margin-top: var(--gutter);
  }

  .offer {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--gutter);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .offer li {
    display: flex;
    flex-direction: column;
    gap: 0.5em;
    padding: var(--gutter);
    background: var(--white);
    border: var(--border);
    box-shadow: var(--shadow-sm);
  }

  .offer p,
  .studio,
  .person p,
  .sent p {
    font-size: var(--text-body);
  }

  .method {
    max-width: 52ch;
    margin-top: var(--space-dense);
    font-size: var(--text-h3);
    font-weight: 700;
    line-height: 1.3;
  }

  .sub-h {
    margin-top: var(--space-dense);
  }

  .verticals {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin: var(--gutter) 0 0;
    padding: 0;
    list-style: none;
  }

  .verticals li {
    padding: 0.4em 0.8em;
    background: var(--white);
    border: var(--border);
    font-weight: 700;
  }

  .studio {
    margin-top: var(--gutter);
  }

  .studio a {
    margin-left: 0.4em;
    font-weight: 700;
    text-decoration: underline;
    text-decoration-thickness: 3px;
    text-underline-offset: 0.2em;
  }

  .work {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--gutter);
    margin: var(--gutter) 0 0;
    padding: 0;
    list-style: none;
  }

  .work li {
    display: flex;
    flex-direction: column;
    gap: 0.5em;
    padding: var(--gutter);
    background: var(--white);
    border: var(--border);
    box-shadow: var(--shadow-lg);
  }

  .metric {
    font-size: clamp(3rem, 6vw, 5rem);
  }

  .people {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-dense) calc(var(--gutter) * 2);
    margin-top: var(--space-dense);
  }

  .person {
    display: grid;
    grid-template-columns: 8rem 1fr;
    gap: var(--gutter) calc(var(--gutter) * 1.5);
    align-items: start;
  }

  .person p {
    margin-top: 0.5em;
  }

  .form {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--gutter);
    max-width: 52rem;
  }

  label {
    display: flex;
    flex-direction: column;
    gap: 0.4em;
    font-weight: 700;
  }

  .trap {
    position: absolute;
    left: -200vw;
    width: 1px;
    height: 1px;
    overflow: hidden;
  }

  input,
  select,
  textarea {
    padding: 0.7em 0.9em;
    font: inherit;
    color: var(--ink);
    background: var(--white);
    border: var(--border);
  }

  input:focus-visible,
  select:focus-visible,
  textarea:focus-visible {
    outline: 3px solid var(--ink);
    outline-offset: 2px;
  }

  .submit {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--gutter);
  }

  .consent a {
    margin-left: 0.5em;
    text-decoration: underline;
    text-decoration-thickness: 2px;
    text-underline-offset: 0.2em;
  }

  .consent {
    max-width: 40ch;
    font-weight: 400;
  }

  .status {
    padding: var(--gutter);
    background: var(--white);
    border: var(--border);
  }

  .sent {
    max-width: 52rem;
    padding: var(--gutter);
    background: var(--lime);
    border: var(--border);
    box-shadow: var(--shadow-lg);
  }

  @media (min-width: 900px) {
    .two,
    .people,
    .form {
      grid-template-columns: 1fr 1fr;
    }

    .offer {
      grid-template-columns: repeat(5, 1fr);
    }

    .work {
      grid-template-columns: repeat(3, 1fr);
    }

    .wide {
      grid-column: 1 / -1;
    }
  }
</style>
