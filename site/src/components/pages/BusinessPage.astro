---
/**
 * /business, nav "Companies" (v3): training and development on one page,
 * one inquiry form that posts JSON to the funnel app's /api/inquiry.
 * Section ids match the home router's links (#training, #development).
 */
import { getRelativeLocaleUrl } from 'astro:i18n';
import { INQUIRY_URL } from '../../config';
import { asLocale, t, tList, tRecords } from '../../i18n/utils';
import Button from '../Button.astro';
import Flowchart from '../Flowchart.astro';
import PhotoFrame from '../PhotoFrame.astro';
import Section from '../Section.astro';

const locale = asLocale(Astro.currentLocale);
const formats = tRecords(locale, 'business.training.formats');
const head = tList(locale, 'business.training.table_head');
const work = tRecords(locale, 'business.services.work');
const interests = tRecords(locale, 'business.form.interest_options');
const required = t(locale, 'business.form.required');
// Inline validation messages, read by the form script (no native bubbles).
const errors = {
  name: t(locale, 'business.form.errors.name'),
  company: t(locale, 'business.form.errors.company'),
  email: t(locale, 'business.form.errors.email'),
  email_format: t(locale, 'business.form.errors.email_format'),
};
const verticals = tList(locale, 'business.services.verticals');
const studioLink = t(locale, 'business.services.studio_link');
---

<Section bg="paper" density="medium">
  <img class="hero-clay" src="/clay/ring.webp" alt="" aria-hidden="true" width="480" height="480" decoding="async" />
  <h1 class="display big">{t(locale, 'business.hero.headline')}</h1>
  <p class="sub">{t(locale, 'business.hero.sub')}</p>
  <div class="jumps">
    <Button href="#training" size="md">{t(locale, 'business.hero.jump_training')}</Button>
    <Button href="#development" size="md" variant="secondary">{t(locale, 'business.hero.jump_services')}</Button>
  </div>
</Section>

<Section bg="white" density="dense" id="training">
  <h2 id={`training-h-${locale}`}>{t(locale, 'business.training.headline')}</h2>
  <p class="lead">{t(locale, 'business.training.body')}</p>

  <!-- Named by the heading and focusable in case it scrolls sideways (between 640px and the table's min width). Below 640px each row is a card. -->
  <div class="table-wrap" tabindex="0" role="region" aria-labelledby={`training-h-${locale}`}>
    <table class="formats">
      <thead>
        <tr>{head.map((h) => <th scope="col">{h}</th>)}</tr>
      </thead>
      <tbody>
        {
          formats.map((f) => (
            <tr>
              <th scope="row">{f.title}</th>
              <td data-label={head[1]}>{f.length}</td>
              <td data-label={head[2]}>{f.group}</td>
              <td data-label={head[3]}>{f.line}</td>
            </tr>
          ))
        }
      </tbody>
    </table>
  </div>
  <p class="it">{t(locale, 'business.training.it')}</p>

  <div class="two">
    <div>
      <h3>{t(locale, 'business.training.outcomes_headline')}</h3>
      <ul class="outcomes">
        {tList(locale, 'business.training.outcomes').map((line) => <li>{line}</li>)}
      </ul>
    </div>
    <div>
      <h3>{t(locale, 'business.training.process_headline')}</h3>
      <div class="process">
        <Flowchart labels={tList(locale, 'business.training.process')} />
      </div>
    </div>
  </div>
</Section>

<Section bg="paper" density="dense" id="development">
  <h2>{t(locale, 'business.services.headline')}</h2>
  <p class="lead">{t(locale, 'business.services.body')}</p>
  <ul class="offer">
    {
      tRecords(locale, 'business.services.offer').map((item) => (
        <li>
          <h3>{item.title}</h3>
          <p>{item.line}</p>
        </li>
      ))
    }
  </ul>
  <p class="method">{t(locale, 'business.services.method')}</p>

  <h3 class="sub-h">{t(locale, 'business.services.verticals_headline')}</h3>
  <ul class="verticals">
    {verticals.map((v) => <li>{v}</li>)}
  </ul>
  <p class="studio">
    {t(locale, 'business.services.studio')}
    <a href={`https://${studioLink}`} rel="noopener">{studioLink}</a>
  </p>

  {
    work.length > 0 && (
      <>
        <h3 class="sub-h">{t(locale, 'business.services.work_headline')}</h3>
        <ul class="work">
          {work.map((w) => (
            <li>
              <span class="display metric">{w.metric}</span>
              <span>{w.line}</span>
            </li>
          ))}
        </ul>
      </>
    )
  }
</Section>

<Section bg="white" density="dense">
  <h2>{t(locale, 'business.team.headline')}</h2>
  <div class="people">
    {
      tRecords(locale, 'business.team.people').map((person, i) => (
        <div class="person">
          <div class="photo">
            <PhotoFrame alt={person.name} initial={person.name.slice(0, 1)} rotate={i % 2 ? 2 : -2} tape={person.name} />
          </div>
          <div>
            <h3>{person.name}</h3>
            <p>{person.credentials}</p>
          </div>
        </div>
      ))
    }
  </div>
</Section>

<Section bg="pink" density="dense" id="inquiry">
  <h2>{t(locale, 'business.form.headline')}</h2>
  <p class="lead">{t(locale, 'business.form.body')}</p>
  <form class="form" method="post" action={INQUIRY_URL} data-inquiry data-endpoint={INQUIRY_URL} data-locale={locale} data-sending={t(locale, 'business.form.sending')} data-errors={JSON.stringify(errors)} novalidate>
    <div class="field">
      <label for="inquiry-name">{t(locale, 'business.form.name')} <span class="req" aria-hidden="true">{required}</span></label>
      <input id="inquiry-name" name="name" type="text" required maxlength="120" autocomplete="name" aria-describedby="inquiry-err-name" />
      <span class="error" id="inquiry-err-name" data-error-for="name" hidden></span>
    </div>
    <div class="field">
      <label for="inquiry-company">{t(locale, 'business.form.company')} <span class="req" aria-hidden="true">{required}</span></label>
      <input id="inquiry-company" name="company" type="text" required maxlength="160" autocomplete="organization" aria-describedby="inquiry-err-company" />
      <span class="error" id="inquiry-err-company" data-error-for="company" hidden></span>
    </div>
    <label><span>{t(locale, 'business.form.role')}</span><input name="role" type="text" maxlength="120" autocomplete="organization-title" /></label>
    <div class="field">
      <label for="inquiry-email">{t(locale, 'business.form.email')} <span class="req" aria-hidden="true">{required}</span></label>
      <input id="inquiry-email" name="email" type="email" required maxlength="200" autocomplete="email" aria-describedby="inquiry-err-email" />
      <span class="error" id="inquiry-err-email" data-error-for="email" hidden></span>
    </div>
    <label
      ><span>{t(locale, 'business.form.interest')}</span>
      <select name="interest">
        {interests.map((option) => <option value={option.value}>{option.label}</option>)}
      </select>
    </label>
    <label><span>{t(locale, 'business.form.team_size')}</span><input name="team_size" type="text" maxlength="40" /></label>
    <label class="wide"><span>{t(locale, 'business.form.message')}</span><textarea name="message" rows="5" maxlength="4000"></textarea></label>
    <label class="trap" aria-hidden="true"><span>Website</span><input name="website" type="text" tabindex="-1" autocomplete="off" /></label>
    <div class="wide submit">
      <Button size="md" type="submit">{t(locale, 'business.form.submit')}</Button>
      <p class="consent label">
        {t(locale, 'business.form.consent')}
        <a href={getRelativeLocaleUrl(locale, 'privacy')}>{t(locale, 'footer.privacy')}</a>
      </p>
    </div>
    <p class="status failed label" role="alert" data-failed hidden>{t(locale, 'business.form.failed')}</p>
  </form>
  <div class="sent" role="status" data-sent hidden>
    <h3 tabindex="-1" data-sent-title>{t(locale, 'business.form.sent_title')}</h3>
    <p>{t(locale, 'business.form.sent_body')}</p>
  </div>
</Section>

<script>
  const form = document.querySelector<HTMLFormElement>('[data-inquiry]');
  if (form) {
    const endpoint = form.dataset.endpoint ?? '';
    const locale = form.dataset.locale ?? 'ko';
    const failed = form.querySelector<HTMLElement>('[data-failed]');
    const sent = document.querySelector<HTMLElement>('[data-sent]');
    const button = form.querySelector<HTMLButtonElement>('button[type=submit]');
    const idle = button?.textContent ?? '';

    const messages: Record<string, string> = JSON.parse(form.dataset.errors ?? '{}');
    const fields = Array.from(form.querySelectorAll<HTMLInputElement>('input[required]'));
    let attempted = false;

    // Inline errors with aria-invalid, shown only after the first submit
    // attempt; a flagged field clears itself as soon as it becomes valid.
    const check = (input: HTMLInputElement) => {
      const error = form.querySelector<HTMLElement>(`[data-error-for="${input.name}"]`);
      let message = '';
      if (input.validity.valueMissing || !input.value.trim()) message = messages[input.name] ?? '';
      else if (input.validity.typeMismatch) message = messages[`${input.name}_format`] ?? '';
      if (message) input.setAttribute('aria-invalid', 'true');
      else input.removeAttribute('aria-invalid');
      if (error) {
        error.textContent = message;
        error.hidden = !message;
      }
      return !message;
    };

    fields.forEach((input) =>
      input.addEventListener('input', () => {
        if (attempted) check(input);
      }),
    );

    form.addEventListener('submit', async (event) => {
      event.preventDefault();
      attempted = true;
      const invalid = fields.filter((input) => !check(input));
      if (invalid.length) {
        invalid[0].focus();
        return;
      }
      if (failed) failed.hidden = true;
      if (button) {
        button.disabled = true;
        button.textContent = form.dataset.sending ?? idle;
      }
      const data = Object.fromEntries(new FormData(form).entries());
      try {
        const res = await fetch(endpoint, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ ...data, locale }),
        });
        if (!res.ok) throw new Error(String(res.status));
        form.hidden = true;
        if (sent) {
          sent.hidden = false;
          sent.querySelector<HTMLElement>('[data-sent-title]')?.focus();
        }
      } catch {
        if (failed) failed.hidden = false;
        if (button) {
          button.disabled = false;
          button.textContent = idle;
        }
      }
    });
  }
</script>

<style>
  .big {
    max-width: 14ch;
    font-size: clamp(2.75rem, 6.5vw, 5.5rem);
    text-wrap: pretty;
  }

  .sub,
  .lead {
    max-width: 56ch;
    margin-top: var(--gutter);
    font-size: var(--text-body);
  }

  .lead {
    margin-bottom: var(--space-dense);
  }

  .jumps {
    display: flex;
    flex-wrap: wrap;
    gap: var(--gutter);
    margin-top: var(--space-dense);
  }

  .table-wrap {
    overflow-x: auto;
    border-radius: var(--radius);
  }

  /* Glass table: soft sun header, hairline rules, rounded outer corners. */
  .formats {
    width: 100%;
    min-width: 40rem;
    border: 1px solid var(--glass-edge);
    border-radius: var(--radius);
    border-collapse: separate;
    border-spacing: 0;
    overflow: hidden;
    background: var(--glass);
    box-shadow: var(--shadow-sm);
  }

  .formats th,
  .formats td {
    padding: var(--gutter);
    text-align: left;
    vertical-align: top;
    font-size: var(--text-body);
    border-top: var(--border);
  }

  .formats thead th {
    background: var(--yellow);
    color: var(--ink);
    border-top: 0;
  }

  .formats th + th,
  .formats td + td,
  .formats th + td {
    border-left: var(--border);
  }

  .formats tbody th {
    font-weight: 700;
    white-space: nowrap;
  }

  /* Phones: each format is its own glass card, the column names as small
     labels, so nothing is cut off in a sideways scroll. */
  @media (max-width: 639px) {
    .formats,
    .formats tbody,
    .formats tr,
    .formats th,
    .formats td {
      display: block;
    }

    .formats {
      min-width: 0;
      border: 0;
      background: none;
      box-shadow: none;
      overflow: visible;
    }

    .formats thead {
      position: absolute;
      width: 1px;
      height: 1px;
      overflow: hidden;
      clip-path: inset(50%);
    }

    .formats tbody {
      display: grid;
      gap: 0.75rem;
    }

    .formats tbody tr {
      padding: 0.25rem var(--gutter) var(--gutter);
      background: var(--glass);
      border: 1px solid var(--glass-edge);
      border-radius: var(--radius);
      box-shadow: var(--shadow-sm);
    }

    .formats th,
    .formats td {
      padding: 0.6rem 0 0;
      border: 0;
    }

    .formats th + th,
    .formats td + td,
    .formats th + td {
      border-left: 0;
    }

    .formats tbody th {
      white-space: normal;
      font-size: var(--text-h3);
    }

    .formats td::before {
      content: attr(data-label);
      display: block;
      font-size: var(--text-label);
      font-weight: 700;
      color: var(--grey-text);
    }
  }

  .it {
    max-width: 56ch;
    margin-top: var(--gutter);
    padding: var(--gutter);
    background: var(--lime);
    border: var(--border);
    border-radius: var(--radius);
    font-size: var(--text-body);
    font-weight: 700;
  }

  .two {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-dense) calc(var(--gutter) * 2);
    margin-top: var(--space-dense);
  }

  .outcomes {
    margin: var(--gutter) 0 0;
    padding-left: 1.2em;
    font-size: var(--text-body);
    font-weight: 700;
  }

  .process {
    margin-top: var(--gutter);
  }

  .offer {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--gutter);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .offer li {
    display: flex;
    flex-direction: column;
    gap: 0.5em;
    padding: var(--gutter);
    background: var(--surface);
    border: var(--border);
    border-radius: var(--radius);
    box-shadow: var(--shadow-sm);
  }

  .offer p,
  .studio,
  .person p,
  .sent p {
    font-size: var(--text-body);
  }

  .method {
    max-width: 52ch;
    margin-top: var(--space-dense);
    font-size: var(--text-h3);
    font-weight: 700;
    line-height: 1.3;
  }

  .sub-h {
    margin-top: var(--space-dense);
  }

  .verticals {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin: var(--gutter) 0 0;
    padding: 0;
    list-style: none;
  }

  .verticals li {
    padding: 0.4em 0.8em;
    background: var(--surface);
    border: var(--border);
    border-radius: var(--radius);
    font-weight: 700;
  }

  .studio {
    margin-top: var(--gutter);
  }

  .studio a {
    margin-left: 0.4em;
    font-weight: 700;
    text-decoration: underline;
    text-decoration-thickness: 3px;
    text-underline-offset: 0.2em;
  }

  .work {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--gutter);
    margin: var(--gutter) 0 0;
    padding: 0;
    list-style: none;
  }

  .work li {
    display: flex;
    flex-direction: column;
    gap: 0.5em;
    padding: var(--gutter);
    background: var(--surface);
    border: var(--border);
    border-radius: var(--radius);
    box-shadow: var(--shadow-lg);
  }

  .metric {
    font-size: clamp(3rem, 6vw, 5rem);
  }

  .people {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-dense) calc(var(--gutter) * 2);
    margin-top: var(--space-dense);
  }

  .person {
    display: grid;
    grid-template-columns: 8rem 1fr;
    gap: var(--gutter) calc(var(--gutter) * 1.5);
    align-items: start;
  }

  .person p {
    margin-top: 0.5em;
  }

  .form {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--gutter);
    max-width: 52rem;
  }

  label,
  .field {
    display: flex;
    flex-direction: column;
    gap: 0.4em;
    font-weight: 700;
  }

  .field label {
    display: block;
  }

  .trap {
    position: absolute;
    left: -200vw;
    width: 1px;
    height: 1px;
    overflow: hidden;
  }

  input,
  select,
  textarea {
    padding: 0.7em 0.9em;
    font: inherit;
    color: var(--ink);
    background: var(--surface);
    border: var(--border);
    border-radius: var(--radius);
  }

  input:focus-visible,
  select:focus-visible,
  textarea:focus-visible {
    outline: 3px solid var(--ink);
    outline-offset: 2px;
  }

  .submit {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--gutter);
  }

  .req {
    margin-left: 0.25em;
    padding: 0.1em 0.4em;
    font-size: var(--text-label);
    background: var(--surface);
    border: var(--border-thin);
    border-radius: var(--radius-sm);
    vertical-align: 0.1em;
  }

  .error {
    align-self: flex-start;
    padding: 0.25em 0.6em;
    font-size: var(--text-label);
    background: var(--ink);
    color: var(--paper);
  }

  .error[hidden] {
    display: none;
  }

  input[aria-invalid='true'] {
    box-shadow: var(--shadow-sm);
  }

  .sent h3:focus {
    outline: none;
  }

  .consent a {
    margin-left: 0.5em;
    text-decoration: underline;
    text-decoration-thickness: 2px;
    text-underline-offset: 0.2em;
  }

  .consent {
    max-width: 40ch;
    font-weight: 400;
  }

  .status {
    padding: var(--gutter);
    background: var(--surface);
    border: var(--border);
    border-radius: var(--radius);
  }

  .sent {
    max-width: 52rem;
    padding: var(--gutter);
    background: var(--lime);
    border: var(--border);
    border-radius: var(--radius);
    box-shadow: var(--shadow-lg);
  }

  @media (min-width: 900px) {
    .two,
    .people,
    .form {
      grid-template-columns: 1fr 1fr;
    }

    .offer {
      grid-template-columns: repeat(5, 1fr);
    }

    .work {
      grid-template-columns: repeat(3, 1fr);
    }

    .wide {
      grid-column: 1 / -1;
    }
  }
</style>
