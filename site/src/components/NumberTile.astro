---
/**
 * Proof tile: figure at display scale, label at label size. White, bordered, hard shadow.
 * The figure never wraps ("주 / 10시간 / +" read as three numbers). It shrinks to fit
 * the tile: the parent sets `--fit`, the widest figure's width in em (see Proof.astro).
 */
export interface Props {
  figure: string;
  label: string;
  class?: string;
}

const { figure, label, class: className } = Astro.props;
---

<div class:list={['tile', className]}>
  <p class="figure">{figure}</p>
  <p class="label">{label}</p>
</div>

<style>
  .tile {
    container-type: inline-size;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    gap: var(--gutter);
    padding: var(--gutter);
    background: var(--surface);
    color: var(--ink);
    border: var(--border);
    border-radius: var(--radius);
    box-shadow: var(--shadow-lg);
  }

  .figure {
    font-size: min(clamp(3rem, 8vw, var(--text-display)), calc(100cqi / var(--fit, 3)));
    font-weight: 800;
    white-space: nowrap;
    line-height: 0.95;
    letter-spacing: -0.02em;
  }
</style>
