---
/**
 * Home: the seven tracks on one spine, compact. The twelve-week strip and
 * seven name chips that link to the courses page, where the detail lives.
 * Students and founders shouldn't have to scroll past seven worker cards.
 */
import { getRelativeLocaleUrl } from 'astro:i18n';
import { t, tList, tRecords, type Locale } from '../../i18n/utils';
import Section from '../Section.astro';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const strip = tList(locale, 'home.tracks.strip');
const items = tRecords(locale, 'home.tracks.items');
const courses = `${getRelativeLocaleUrl(locale, 'courses')}#tracks`;
const SPANS = [3, 7, 2];
const FILLS = ['paper', 'lime', 'yellow'];
---

<Section bg="white" density="dense" id="tracks">
  <div class="grid">
    <div class="lead">
      <h2>{t(locale, 'home.tracks.headline')}</h2>
      <p class="sub">{t(locale, 'home.tracks.sub')}</p>
      <a class="link" href={courses}>{t(locale, 'home.tracks.link')}</a>
    </div>

    <div class="right">
      <div class="strip" role="img" aria-label={strip.join('. ')}>
        {
          strip.map((label, i) => (
            <span class="cell" style={`flex: ${SPANS[i]}; background: var(--${FILLS[i]})`}>
              <span class="weeks label">{label}</span>
            </span>
          ))
        }
      </div>

      <ul class="chips">
        {
          items.map((track) => (
            <li>
              <a class:list={['chip', 'press', track.status]} href={courses}>
                <span class="code label">{track.code}</span>
                <span>{track.name}</span>
              </a>
            </li>
          ))
        }
      </ul>
      <p class="note">{t(locale, 'home.tracks.note')}</p>
    </div>
  </div>
</Section>

<style>
  .grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-dense) calc(var(--gutter) * 2);
    align-items: start;
  }

  .lead {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: var(--gutter);
  }

  .sub {
    max-width: 44ch;
    font-size: var(--text-body);
  }

  .link {
    font-weight: 700;
    text-decoration: underline;
    text-decoration-thickness: 3px;
    text-underline-offset: 0.2em;
  }

  .strip {
    display: flex;
    border: var(--border);
  }

  .cell {
    display: flex;
    align-items: flex-end;
    min-height: 5rem;
    padding: 0.75rem;
  }

  .cell + .cell {
    border-left: var(--border);
  }

  .chips {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin: var(--gutter) 0 0;
    padding: 0;
    list-style: none;
  }

  .chip {
    display: inline-flex;
    align-items: center;
    gap: 0.6em;
    padding: 0.5em 0.9em;
    background: var(--white);
    border: var(--border);
    box-shadow: var(--shadow-sm);
    font-weight: 700;
    text-decoration: none;
  }

  .chip.waitlist {
    background: var(--paper);
    color: var(--grey-text);
  }

  .code {
    padding: 0.1em 0.4em;
    border: var(--border-thin);
    background: var(--lime);
    color: var(--ink);
  }

  .chip.waitlist .code {
    background: var(--yellow);
  }

  .note {
    margin-top: var(--gutter);
    font-size: var(--text-body);
    font-weight: 700;
  }

  @media (min-width: 900px) {
    .grid {
      grid-template-columns: 5fr 7fr;
    }

    .cell {
      min-height: 6rem;
    }
  }
</style>
