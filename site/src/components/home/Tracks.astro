---
/**
 * Home: the seven tracks on one spine. A three-cell strip for the twelve
 * weeks, then seven cards at name-and-who level with a status label.
 * Deliberately no weekly detail here; that lives on the courses page.
 */
import { t, tList, tRecords, type Locale } from '../../i18n/utils';
import Section from '../Section.astro';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const strip = tList(locale, 'home.tracks.strip');
const items = tRecords(locale, 'home.tracks.items');
const SPANS = [3, 7, 2];
const FILLS = ['paper', 'lime', 'yellow'];
---

<Section bg="white" density="dense" id="tracks">
  <h2>{t(locale, 'home.tracks.headline')}</h2>
  <p class="sub">{t(locale, 'home.tracks.sub')}</p>

  <div class="strip" role="img" aria-label={strip.join('. ')}>
    {
      strip.map((label, i) => (
        <span class="cell" style={`flex: ${SPANS[i]}; background: var(--${FILLS[i]})`}>
          <span class="weeks label">{label}</span>
        </span>
      ))
    }
  </div>

  <ul class="cards">
    {
      items.map((track) => (
        <li class:list={['card', { open: track.status === 'open' }]}>
          <span class="top">
            <span class="code label">{track.code}</span>
            <span class:list={['status', 'label', track.status]}>{t(locale, `home.tracks.status.${track.status}`)}</span>
          </span>
          <h3>{track.name}</h3>
          <p>{track.who}</p>
        </li>
      ))
    }
  </ul>

  <p class="note">{t(locale, 'home.tracks.note')}</p>
</Section>

<style>
  h2 {
    max-width: 16ch;
  }

  .sub {
    max-width: 60ch;
    margin: var(--gutter) 0 var(--space-dense);
    font-size: var(--text-body);
  }

  .strip {
    display: flex;
    border: var(--border);
    margin-bottom: var(--space-dense);
  }

  .cell {
    display: flex;
    align-items: flex-end;
    min-height: 5rem;
    padding: 0.75rem;
  }

  .cell + .cell {
    border-left: var(--border);
  }

  .cards {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--gutter);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .card {
    display: flex;
    flex-direction: column;
    gap: 0.5em;
    padding: var(--gutter);
    background: var(--paper);
    border: var(--border);
    box-shadow: var(--shadow-sm);
  }

  .card.open {
    background: var(--white);
  }

  .top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--gutter);
  }

  .status {
    padding: 0.2em 0.6em;
    border: var(--border-thin);
    background: var(--grey-fill);
  }

  .status.open {
    background: var(--lime);
  }

  .status.waitlist {
    background: var(--yellow);
  }

  .card p {
    font-size: var(--text-body);
  }

  .note {
    margin-top: var(--gutter);
    font-size: var(--text-body);
    font-weight: 700;
  }

  @media (min-width: 700px) {
    .cards {
      grid-template-columns: 1fr 1fr;
    }
  }

  @media (min-width: 1100px) {
    .cards {
      grid-template-columns: repeat(4, 1fr);
    }

    .cell {
      min-height: 6rem;
    }

    .weeks {
      font-size: var(--text-body);
    }
  }
</style>
