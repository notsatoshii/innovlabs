---
/** Home section 2 (blueprint row 2): headline, four audience cards. Company card yellow. */
import { getRelativeLocaleUrl } from 'astro:i18n';
import { APP_URL, HAGWON_URL } from '../../config';
import { t, type Locale } from '../../i18n/utils';
import Icon from '../Icon.astro';
import Section from '../Section.astro';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const business = getRelativeLocaleUrl(locale, 'business');
const tracks = `${getRelativeLocaleUrl(locale, 'courses')}#tracks`;

// Worker goes to the tracks on this page; students and founders go to the
// app's fork screen, whose student and solo doors are waitlists today.
// Doors in order of who the brand serves first: 학원 원장, 직장인, then the
// company card; students and founders are waitlists, so they sit in a quieter row.
const DOORS = [
  { key: 'hagwon', icon: 'timetable', href: HAGWON_URL },
  { key: 'worker', icon: 'worker', href: tracks },
] as const;
const WAITLISTS = [
  { key: 'student', icon: 'student', href: APP_URL },
  { key: 'founder', icon: 'founder', href: APP_URL },
] as const;
---

<Section bg="paper" density="dense">
  <h2>{t(locale, 'home.router.headline')}</h2>
  <div class="cards">
    {
      DOORS.map((a) => (
        <a class:list={['card press', { first: a.key === 'hagwon' }]} href={a.href}>
          <Icon name={a.icon} />
          <h3>{t(locale, `home.router.${a.key}.title`)}</h3>
          <p>{t(locale, `home.router.${a.key}.promise`)}</p>
          <span class="link">{t(locale, `home.router.${a.key}.link`)}</span>
        </a>
      ))
    }
    <div class="card company">
      <Icon name="company" />
      <h3>{t(locale, 'home.router.company.title')}</h3>
      <p>{t(locale, 'home.router.company.promise')}</p>
      <span class="links">
        <a class="link" href={`${business}#training`}>{t(locale, 'home.router.company.link_training')}</a>
        <a class="link" href={`${business}#development`}>{t(locale, 'home.router.company.link_dev')}</a>
      </span>
    </div>
  </div>
  <div class="later">
    {
      WAITLISTS.map((a) => (
        <a class="card quiet press" href={a.href}>
          <Icon name={a.icon} />
          <h3>{t(locale, `home.router.${a.key}.title`)}</h3>
          <p>{t(locale, `home.router.${a.key}.promise`)}</p>
          <span class="note label">{t(locale, `home.router.${a.key}.note`)}</span>
          <span class="link">{t(locale, `home.router.${a.key}.link`)}</span>
        </a>
      ))
    }
  </div>
</Section>

<style>
  h2 {
    margin-bottom: var(--space-dense);
  }

  .cards {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--gutter);
  }

  .card {
    display: flex;
    flex-direction: column;
    gap: 0.75em;
    padding: var(--gutter);
    background: var(--white);
    color: var(--ink);
    border: var(--border);
    border-radius: var(--radius);
    box-shadow: var(--shadow-lg);
    text-decoration: none;
  }

  .company {
    background: var(--yellow);
  }

  /* The 학원 door leads: marker top rule like a highlighted timetable row. */
  .first {
    border-top-width: 8px;
    border-top-color: var(--marker);
  }

  .later {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--gutter);
    margin-top: var(--gutter);
  }

  .quiet {
    background: var(--grey-fill);
    box-shadow: none;
  }

  p {
    flex: 1;
    font-size: var(--text-body);
  }

  .note {
    padding: 0.2em 0.6em;
    border: var(--border-thin);
    border-radius: var(--radius-sm);
    background: var(--yellow);
    align-self: flex-start;
  }

  .links {
    display: flex;
    flex-direction: column;
    gap: 0.35em;
  }

  .link {
    font-weight: 700;
    text-decoration: underline;
    text-decoration-thickness: 3px;
    text-underline-offset: 0.2em;
  }

  @media (min-width: 600px) {
    .cards {
      grid-template-columns: 1fr 1fr;
    }
  }

  @media (min-width: 600px) {
    .later {
      grid-template-columns: 1fr 1fr;
    }
  }

  @media (min-width: 1000px) {
    .cards {
      grid-template-columns: repeat(3, 1fr);
    }
  }
</style>
