---
/** Home section 2 (blueprint row 2): headline, four audience cards. Company card yellow. */
import { getRelativeLocaleUrl } from 'astro:i18n';
import { t, type Locale } from '../../i18n/utils';
import Icon from '../Icon.astro';
import Section from '../Section.astro';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const courses = getRelativeLocaleUrl(locale, 'courses');
const business = getRelativeLocaleUrl(locale, 'business');

const AUDIENCES = [
  { key: 'worker', icon: 'worker' },
  { key: 'student', icon: 'student' },
  { key: 'founder', icon: 'founder' },
] as const;
---

<Section bg="paper" density="dense" style="--pad-top: calc(var(--space-dense) + var(--overhang))">
  <h2>{t(locale, 'home.router.headline')}</h2>
  <div class="cards">
    {
      AUDIENCES.map((a) => (
        <a class="card press" href={courses}>
          <Icon name={a.icon} />
          <h3>{t(locale, `home.router.${a.key}.title`)}</h3>
          <p>{t(locale, `home.router.${a.key}.promise`)}</p>
          <span class="link">{t(locale, `home.router.${a.key}.link`)}</span>
        </a>
      ))
    }
    <div class="card company">
      <Icon name="company" />
      <h3>{t(locale, 'home.router.company.title')}</h3>
      <p>{t(locale, 'home.router.company.promise')}</p>
      <span class="links">
        <a class="link" href={`${business}#training`}>{t(locale, 'home.router.company.link_training')}</a>
        <a class="link" href={`${business}#development`}>{t(locale, 'home.router.company.link_dev')}</a>
      </span>
    </div>
  </div>
</Section>

<style>
  h2 {
    margin-bottom: var(--space-dense);
  }

  .cards {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--gutter);
  }

  .card {
    display: flex;
    flex-direction: column;
    gap: 0.75em;
    padding: var(--gutter);
    background: var(--white);
    color: var(--ink);
    border: var(--border);
    box-shadow: var(--shadow-lg);
    text-decoration: none;
  }

  .company {
    background: var(--yellow);
  }

  p {
    flex: 1;
    font-size: var(--text-body);
  }

  .links {
    display: flex;
    flex-direction: column;
    gap: 0.35em;
  }

  .link {
    font-weight: 700;
    text-decoration: underline;
    text-decoration-thickness: 3px;
    text-underline-offset: 0.2em;
  }

  @media (min-width: 600px) {
    .cards {
      grid-template-columns: 1fr 1fr;
    }
  }

  @media (min-width: 1100px) {
    .cards {
      grid-template-columns: repeat(4, 1fr);
    }
  }
</style>
