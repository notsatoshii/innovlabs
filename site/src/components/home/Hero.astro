---
/**
 * Home section 1 (docs/brand/README.md): a frosted glass card over real-time
 * clay objects. The card is a carousel: slide 1 is the original hero copy,
 * then one slide per persona, switched by the mini tabs underneath. All
 * slides render on the server stacked in one grid cell, so the card keeps the
 * tallest slide's height and the first slide works without JavaScript.
 */
import { getRelativeLocaleUrl } from 'astro:i18n';
import { APP_URL, HAGWON_URL, SOLO_URL, STUDENT_URL } from '../../config';
import { t, tList, tRaw, type Locale } from '../../i18n/utils';
import Button from '../Button.astro';
import ClayScene from '../ClayScene.astro';
import type { Placement } from '../../scripts/clay-scene';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;

interface Persona {
  key: string;
  tab: string;
  head: string;
  mark: string;
  sub?: string;
  meta?: string;
  cta1: string;
  cta1_to: string;
  cta2?: string;
  cta2_to?: string;
}

const business = getRelativeLocaleUrl(locale, 'business');
const HREF: Record<string, string> = {
  app: APP_URL,
  hagwon: HAGWON_URL,
  student: STUDENT_URL,
  solo: SOLO_URL,
  tracks: `${getRelativeLocaleUrl(locale, 'courses')}#tracks`,
  inquiry: `${business}#inquiry`,
  training: `${business}#training`,
};

/** Split a headline around its highlighted phrase. */
function split(text: string, mark: string) {
  const at = text.indexOf(mark);
  return at < 0 ? { before: text, mark: '', after: '' } : { before: text.slice(0, at), mark, after: text.slice(at + mark.length) };
}

const hero = split(t(locale, 'home.hero.headline'), t(locale, 'home.hero.headline_sticker'));
const personas = tRaw<Persona[]>(locale, 'home.personas.slides');
const tabs = [t(locale, 'home.personas.tab_all'), ...personas.map((p) => p.tab)];

// Clay placements as fractions of the hero box; `m` is the phone layout (null hides it).
const LAYOUT: Placement[] = [
  { kind: 'asterisk', x: 0.82, y: 0.3, s: 1.45, rz: 0.2, m: { x: 0.85, y: 0.06, s: 0.75 } },
  { kind: 'cap', x: 0.67, y: 0.7, s: 0.92, ry: -0.7, m: null },
  { kind: 'books', x: 0.94, y: 0.8, s: 0.82, ry: -0.6, m: { x: 0.9, y: 0.96, s: 0.62 } },
  { kind: 'bubble', x: 0.58, y: 0.15, s: 0.72, ry: 0.35, m: { x: 0.13, y: 0.045, s: 0.42 } },
  { kind: 'ring', x: 0.03, y: 0.95, s: 0.95, rx: 1.1, m: { x: 0.06, y: 0.97, s: 0.62 } },
  { kind: 'ballSun', x: 0.47, y: 0.92, s: 0.48, m: null },
];
---

<section class="hero" data-hero>
  <ClayScene layout={LAYOUT} />
  <div class="inner">
    <div class="cols">
      <div class="card glass">
        <div class="panels">
          <div class="panel" role="tabpanel" id={`hero-p0-${locale}`} aria-labelledby={`hero-t0-${locale}`}>
            <p class="stat">{t(locale, 'home.hero.stat')}</p>
            <h1 class="headline">{hero.before}{hero.mark && <mark>{hero.mark}</mark>}{hero.after}</h1>
            <p class="sub">{t(locale, 'home.hero.sub')}</p>
            <div class="ctas">
              <Button href={APP_URL} size="md">{t(locale, 'home.hero.cta_primary')}</Button>
              <Button href={business} size="md" variant="secondary">{t(locale, 'home.hero.cta_secondary')}</Button>
            </div>
          </div>
          {
            personas.map((p, i) => {
              const h = split(p.head, p.mark);
              return (
                <div class="panel off" role="tabpanel" id={`hero-p${i + 1}-${locale}`} aria-labelledby={`hero-t${i + 1}-${locale}`} aria-hidden="true" inert>
                  <h2 class="headline">{h.before}{h.mark && <mark>{h.mark}</mark>}{h.after}</h2>
                  {p.sub && <p class="sub">{p.sub}</p>}
                  {p.meta && <p class="meta">{p.meta}</p>}
                  <div class="ctas">
                    <Button href={HREF[p.cta1_to]} size="md">{p.cta1}</Button>
                    {p.cta2 && p.cta2_to && <Button href={HREF[p.cta2_to]} size="md" variant="secondary">{p.cta2}</Button>}
                  </div>
                </div>
              );
            })
          }
        </div>
      </div>
      <ul class="chips">
        {tList(locale, 'home.hero.stickers').map((s) => <li class="chip glass">{s}</li>)}
      </ul>
    </div>
    <div class="tabs glass" role="tablist" aria-label={t(locale, 'home.personas.label')}>
      {
        tabs.map((label, i) => (
          <button
            type="button"
            class="tab"
            role="tab"
            id={`hero-t${i}-${locale}`}
            aria-controls={`hero-p${i}-${locale}`}
            aria-selected={i === 0 ? 'true' : 'false'}
            tabindex={i === 0 ? 0 : -1}
          >
            {label}
          </button>
        ))
      }
    </div>
  </div>
</section>

<script>
  // Persona carousel: tabs switch slides; it also rotates every 6 s while in
  // view, pausing on hover or focus and stopping for good after any tap.
  document.querySelectorAll<HTMLElement>('[data-hero]').forEach((root) => {
    const tabs = [...root.querySelectorAll<HTMLButtonElement>('[role="tab"]')];
    const panels = [...root.querySelectorAll<HTMLElement>('[role="tabpanel"]')];
    const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    let current = 0;
    let timer: number | undefined;
    let stopped = reduce;
    let inView = false;

    function show(i: number) {
      current = i;
      tabs.forEach((tab, j) => {
        tab.setAttribute('aria-selected', String(j === i));
        tab.tabIndex = j === i ? 0 : -1;
      });
      panels.forEach((panel, j) => {
        const on = j === i;
        panel.classList.toggle('off', !on);
        panel.toggleAttribute('inert', !on);
        if (on) panel.removeAttribute('aria-hidden');
        else panel.setAttribute('aria-hidden', 'true');
      });
    }
    function stop() {
      stopped = true;
      window.clearInterval(timer);
    }
    function pause() {
      window.clearInterval(timer);
      timer = undefined;
    }
    function start() {
      if (stopped || timer) return;
      timer = window.setInterval(() => {
        if (inView) show((current + 1) % tabs.length);
      }, 6000);
    }

    tabs.forEach((tab, i) =>
      tab.addEventListener('click', () => {
        stop();
        show(i);
      }),
    );
    root.querySelector('[role="tablist"]')?.addEventListener('keydown', (e) => {
      const key = (e as KeyboardEvent).key;
      if (key !== 'ArrowRight' && key !== 'ArrowLeft') return;
      e.preventDefault();
      stop();
      const n = (current + (key === 'ArrowRight' ? 1 : tabs.length - 1)) % tabs.length;
      show(n);
      tabs[n].focus();
    });
    root.addEventListener('pointerenter', pause);
    root.addEventListener('pointerleave', start);
    root.addEventListener('focusin', pause);
    root.addEventListener('touchstart', stop, { passive: true });
    new IntersectionObserver((entries) => {
      inView = entries[0].isIntersecting;
    }, { threshold: 0.4 }).observe(root);
    start();
  });
</script>

<style>
  .hero {
    position: relative;
    overflow: hidden;
    isolation: isolate;
    border-bottom: var(--border);
  }

  .inner {
    position: relative;
    z-index: 1;
    max-width: var(--max-width);
    margin-inline: auto;
    padding: clamp(1.5rem, 4vw, 3.5rem) var(--gutter) clamp(2rem, 4vw, 3rem);
    display: grid;
    gap: 1.25rem;
  }

  .cols {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 1rem;
    align-items: end;
  }

  .card {
    border-radius: var(--radius-lg);
    padding: clamp(1.25rem, 3vw, 2.25rem);
  }

  /* Every slide shares one grid cell: the card is as tall as the tallest. */
  .panels {
    display: grid;
  }

  /* Each slide fills the shared cell and centres its content, so a short
     slide splits the spare height above and below instead of leaving a gap. */
  .panel {
    grid-area: 1 / 1;
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: flex-start;
    gap: 0.9rem;
    transition: opacity 400ms var(--ease), transform 400ms var(--ease);
  }

  .panel.off {
    visibility: hidden;
    opacity: 0;
    transform: translateY(8px);
  }

  .stat {
    padding: 0.4em 0.85em;
    border-radius: 999px;
    background: rgba(255, 255, 255, 0.75);
    font-size: var(--text-label);
    font-weight: 800;
    line-height: 1.4;
  }

  .headline {
    font-size: clamp(2.125rem, 4.4vw, 3.5rem);
    line-height: 1.2;
    max-width: 16em;
    text-wrap: balance;
  }

  mark {
    background: var(--lime);
    color: inherit;
    border-radius: 0.3em;
    padding: 0 0.12em;
    box-shadow: inset 2px 3px 4px rgba(255, 255, 255, 0.5), inset -3px -4px 6px rgba(0, 0, 0, 0.1);
    box-decoration-break: clone;
    -webkit-box-decoration-break: clone;
  }

  .sub {
    max-width: 42ch;
    color: var(--grey-text);
  }

  .meta {
    font-size: var(--text-label);
    font-weight: 700;
    color: var(--grey-text);
  }

  .ctas {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-top: 0.4rem;
  }

  .chips {
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .chip {
    border-radius: 999px;
    padding: 0.55em 1.05em;
    font-family: var(--font-display);
    font-size: 1.0625rem;
    box-shadow: var(--shadow-sm), inset 0 1px 0 rgba(255, 255, 255, 0.95);
  }

  .tabs {
    display: flex;
    gap: 0.25rem;
    justify-self: start;
    max-width: 100%;
    overflow-x: auto;
    scrollbar-width: none;
    border-radius: 999px;
    padding: 0.3rem;
    box-shadow: var(--shadow-sm), inset 0 1px 0 rgba(255, 255, 255, 0.95);
  }

  .tabs::-webkit-scrollbar {
    display: none;
  }

  .tab {
    flex: none;
    min-height: 2.5rem;
    padding: 0.45em 1em;
    border: 0;
    border-radius: 999px;
    background: transparent;
    color: var(--grey-text);
    font-size: 0.875rem;
    font-weight: 800;
    white-space: nowrap;
    cursor: pointer;
  }

  .tab[aria-selected='true'] {
    background: var(--action);
    color: var(--white);
    box-shadow: var(--clay-shade);
  }

  @media (min-width: 900px) {
    .cols {
      grid-template-columns: minmax(0, 7fr) minmax(0, 5fr);
    }

    .chips {
      flex-direction: column;
      align-items: flex-start;
    }
  }

  /* Phones: a little room above the card for the asterisk and bubble,
     and the facts as one quiet row so they don't stack into a second card. */
  @media (max-width: 559px) {
    .inner {
      padding-top: 4.5rem;
      gap: 1rem;
    }

    .chips {
      gap: 0.4rem;
    }

    .chip {
      font-size: 0.9375rem;
      padding: 0.45em 0.85em;
    }
  }
</style>
