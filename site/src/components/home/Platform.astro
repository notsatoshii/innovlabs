---
/**
 * Home section 6: headline and body, then the onboarding flowchart at full
 * width (the page's one diagram, so it gets the room), then the four
 * pillars in a row with the survey CTA under them. This departs from the
 * blueprint's 5/7 split, which left the diagram too small to read as one.
 */
import { APP_URL } from '../../config';
import { t, tList, tRecords, type Locale } from '../../i18n/utils';
import Button from '../Button.astro';
import Flowchart from '../Flowchart.astro';
import Icon from '../Icon.astro';
import Section from '../Section.astro';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const pillars = tRecords(locale, 'home.platform.pillars');
const ICONS = ['profile', 'knowledge', 'community', 'toolkit'] as const;
---

<Section bg="white" density="dense">
  <h2>{t(locale, 'home.platform.headline')}</h2>
  <p class="body">{t(locale, 'home.platform.body')}</p>

  <div class="chart">
    <Flowchart labels={tList(locale, 'home.platform.flowchart_labels')} />
  </div>

  <ul class="pillars">
    {
      pillars.map((pillar, index) => (
        <li>
          <Icon name={ICONS[index] ?? 'profile'} />
          <h3>{pillar.title}</h3>
          <p>{pillar.line}</p>
        </li>
      ))
    }
  </ul>

  <div class="cta">
    <Button href={APP_URL} size="md">{t(locale, 'home.platform.cta')}</Button>
  </div>
</Section>

<style>
  h2 {
    max-width: 18ch;
  }

  .body {
    max-width: 56ch;
    margin-top: var(--gutter);
    margin-bottom: var(--space-dense);
    font-size: var(--text-body);
  }

  .chart {
    margin-bottom: var(--space-dense);
  }

  .pillars {
    display: grid;
    grid-template-columns: 1fr;
    margin: 0;
    padding: 0;
    list-style: none;
    background: var(--paper);
    border: var(--border);
  }

  li {
    display: flex;
    flex-direction: column;
    gap: 0.5em;
    padding: var(--gutter);
  }

  li + li {
    border-top: var(--border);
  }

  li p {
    font-size: var(--text-body);
  }

  .cta {
    margin-top: var(--space-dense);
  }

  @media (min-width: 900px) {
    .pillars {
      grid-template-columns: repeat(4, 1fr);
    }

    li + li {
      border-top: 0;
      border-left: var(--border);
    }
  }
</style>
