---
/**
 * Home section 8 (blueprint row 8): ink, sparse. Display headline in the
 * left 8 columns, body, lime button with a yellow shadow, and an oversized
 * lime asterisk rotated 15deg, cropped 40% off the right edge.
 */
import { APP_URL } from '../../config';
import { t, type Locale } from '../../i18n/utils';
import Button from '../Button.astro';
import Section from '../Section.astro';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
---

<Section bg="ink" density="sparse" class="final">
  <div class="text">
    <h2 class="display big">{t(locale, 'home.final.headline')}</h2>
    <p>{t(locale, 'home.final.body')}</p>
    <Button href={APP_URL} size="md" class="yellow-shadow">{t(locale, 'home.final.cta')}</Button>
  </div>
  <img class="asterisk" src="/clay/asterisk-lg.webp" alt="" aria-hidden="true" width="960" height="960" loading="lazy" decoding="async" />
</Section>

<style>
  :global(.final) {
    overflow: hidden;
  }

  .text {
    position: relative;
    z-index: 1;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: var(--gutter);
    max-width: 66.6%;
  }

  .big {
    font-size: clamp(2.75rem, 11vw, var(--text-display));
  }

  p {
    max-width: 40ch;
    font-size: var(--text-body);
  }

  :global(.yellow-shadow) {
    box-shadow: var(--shadow-lg-yellow);
  }

  .asterisk {
    --asterisk: clamp(14rem, 33vw, 30rem);
    position: absolute;
    top: 50%;
    right: calc(-0.4 * var(--asterisk));
    width: var(--asterisk);
    height: var(--asterisk);
    animation: clay-float 7s ease-in-out infinite alternate;
    transform: translateY(-50%) rotate(15deg);
  }

  @media (max-width: 899px) {
    .text {
      max-width: none;
    }
  }

  /* Phones: a smaller asterisk anchored bottom-right, below the button row,
     so it never sits on the body text (site review S3). */
  @media (max-width: 599px) {
    .asterisk {
      --asterisk: 10rem;
      top: auto;
      bottom: calc(-0.3 * var(--asterisk));
      right: calc(-0.25 * var(--asterisk));
      transform: rotate(15deg);
    }
  }
</style>
