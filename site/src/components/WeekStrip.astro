---
/**
 * The twelve-week strip: 12 bordered cells grouped into phases with palette
 * fills (visual spec 4.3). Spans and fills are props so the same strip can
 * show spine / track / capstone (3, 7, 2) or any other grouping.
 */
interface Props {
  phases: string[];
  spans?: number[];
  fills?: string[];
}

const { phases, spans = [3, 7, 2], fills = ['paper', 'lime', 'yellow'] } = Astro.props;
const cells: { week: number; phase: number }[] = [];
let week = 1;
spans.forEach((span, phase) => {
  for (let i = 0; i < span; i++) cells.push({ week: week++, phase });
});
---

<div class="strip" role="img" aria-label={phases.join(', ')}>
  <div class="cells">
    {cells.map((cell) => <span class="cell" style={`background: var(--${fills[cell.phase] ?? 'paper'})`}>{cell.week}</span>)}
  </div>
  <div class="phases">
    {phases.map((phase, i) => <span class="phase label" style={`flex: ${spans[i] ?? 1}`}>{phase}</span>)}
  </div>
</div>

<style>
  .cells {
    display: grid;
    grid-template-columns: repeat(12, 1fr);
    border: var(--border);
  }

  .cell {
    display: grid;
    place-items: center;
    aspect-ratio: 1;
    font-size: var(--text-label);
    font-weight: 700;
  }

  .cell + .cell {
    border-left: var(--border);
  }

  .phases {
    display: flex;
    margin-top: 0.5rem;
  }

  .phase {
    padding-right: 0.5em;
  }
</style>
