---
/** "INNOVLABS" in the display face with the marker superscript square after the S. */
interface Props {
  class?: string;
}

const { class: className } = Astro.props;
---

<span class:list={['wordmark', className]}>INNOVLABS<span class="sup" aria-hidden="true"></span></span>

<style>
  .wordmark {
    position: relative;
    display: inline-block;
    padding-right: 0.5em;
    font-family: var(--font-display);
    font-weight: 400;
    letter-spacing: 0.04em;
    line-height: 1;
    text-transform: uppercase;
  }

  .sup {
    position: absolute;
    top: -0.12em;
    right: 0;
    width: 0.32em;
    height: 0.32em;
    background: var(--marker);
    border: var(--border-thin);
    border-radius: var(--radius-sm);
  }
</style>
