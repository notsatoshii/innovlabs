---
/** Bordered, hard-shadow button. Renders <a> with `href`, <button> without. */
interface Props {
  href?: string;
  variant?: 'primary' | 'secondary' | 'ink' | 'pink';
  size?: 'sm' | 'md';
  type?: 'button' | 'submit';
  class?: string;
}

const { href, variant = 'primary', size = 'md', type = 'button', class: className } = Astro.props;
const Tag = href ? 'a' : 'button';
---

<Tag
  href={href}
  type={href ? undefined : type}
  class:list={['btn', 'press', `v-${variant}`, `s-${size}`, className]}
>
  <slot />
</Tag>

<style>
  /* Clay pill: lit from the top-left, shaded bottom-right, soft lift. */
  .btn {
    display: inline-block;
    border: 0;
    border-radius: 999px;
    box-shadow: var(--clay-shade), var(--shadow-sm);
    font-weight: 800;
    line-height: 1.2;
    text-align: center;
    text-decoration: none;
    white-space: nowrap;
    cursor: pointer;
  }

  .v-primary {
    background: var(--action);
    color: var(--white);
  }
  .v-secondary {
    background: rgba(255, 255, 255, 0.88);
    color: var(--ink);
    box-shadow: inset 2px 3px 4px #fff, inset -3px -5px 8px rgba(0, 0, 0, 0.07), var(--shadow-sm);
  }
  .v-pink {
    background: var(--pink);
    color: var(--ink);
  }
  .v-ink {
    background: var(--ink);
    color: var(--paper);
  }

  .s-md {
    font-size: var(--text-body);
    padding: 0.9em 1.5em;
  }
  .s-sm {
    font-size: var(--text-label);
    padding: 0.75em 1.1em;
  }
</style>
