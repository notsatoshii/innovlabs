---
/**
 * Home page body: the nine blueprint sections (the footer is global).
 * The one script on the page runs the two scroll-triggered draws
 * (motion spec 5.4): the strikes in section 3 and the flowchart in
 * section 6. Each observer fires once and disconnects.
 */
import { asLocale } from '../i18n/utils';
import FinalCta from './home/FinalCta.astro';
import Hero from './home/Hero.astro';
import Not from './home/Not.astro';
import Platform from './home/Platform.astro';
import Programs from './home/Programs.astro';
import Proof from './home/Proof.astro';
import Router from './home/Router.astro';
import Story from './home/Story.astro';
import Tracks from './home/Tracks.astro';

const locale = asLocale(Astro.currentLocale);
---

<Hero locale={locale} />
<Router locale={locale} />
<Not locale={locale} />
<Tracks locale={locale} />
<Programs locale={locale} />
<Platform locale={locale} />
<Story locale={locale} />
<Proof locale={locale} />
<FinalCta locale={locale} />

<script>
  const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  const drawOnce = (selector: string, attribute: string) => {
    const target = document.querySelector<HTMLElement>(selector);
    if (!target) return;
    if (reduceMotion || !('IntersectionObserver' in window)) {
      target.setAttribute(attribute, '');
      return;
    }
    const observer = new IntersectionObserver(
      (entries) => {
        if (entries.some((entry) => entry.isIntersecting)) {
          target.setAttribute(attribute, '');
          observer.disconnect();
        }
      },
      { threshold: 0.3 },
    );
    observer.observe(target);
  };

  drawOnce('[data-strike-root]', 'data-struck');
  drawOnce('[data-flow]', 'data-drawn');
</script>
