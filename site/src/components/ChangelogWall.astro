---
/**
 * Platform hero visual: a dense wall of bordered tiles with honest labels
 * ("new model", "paper", "repo"), slightly overwhelming on purpose, with
 * the asterisk tile cutting through it.
 */
import LogoTile from './LogoTile.astro';

interface Props {
  labels: string[];
}

const { labels } = Astro.props;
const ROTS = [-3, 2, -1, 3, -2, 1, 2, -3, 1, -2, 3, -1, 2, -2, 1];
const FILLS = ['white', 'paper', 'white', 'yellow', 'white', 'paper', 'pink', 'white', 'paper', 'white', 'white', 'yellow', 'paper', 'white', 'white'];
---

<div class="wall" aria-hidden="true">
  {
    labels.map((label, i) => (
      <span class="tile-wrap">
        <span class="tile label" style={`--rot: ${ROTS[i % ROTS.length]}deg; background: var(--${FILLS[i % FILLS.length]})`}>
          {label}
        </span>
      </span>
    ))
  }
  <span class="mark">
    <LogoTile size="clamp(6rem, 12vw, 9rem)" shadow="lg" />
  </span>
</div>

<style>
  .wall {
    position: relative;
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    padding: var(--gutter);
    border: var(--border);
    background: var(--grey-fill);
  }

  .tile-wrap {
    display: inline-block;
  }

  .tile {
    display: inline-block;
    padding: 0.5em 0.8em;
    border: var(--border);
    box-shadow: var(--shadow-pressed);
    color: var(--ink);
    white-space: nowrap;
    transform: rotate(var(--rot));
  }

  .mark {
    position: absolute;
    right: 8%;
    bottom: -12%;
    transform: rotate(-4deg);
  }
</style>
