---
/**
 * Photo treatment (visual spec 4.4): square, full color, 3px border, 6px
 * shadow, rotated -2 to 2 degrees, a lime tape strip across one corner.
 * Without a `src`, a yellow square with a single initial stands in.
 * The wrapper never rotates; the frame peels on hover.
 */
export interface Props {
  src?: string;
  alt: string;
  initial?: string;
  rotate?: number;
  tape?: string;
  class?: string;
}

const { src, alt, initial = '', rotate = -2, tape, class: className } = Astro.props;
---

<span class:list={['frame-wrap', className]}>
  <span class="frame peel" style={`--rot: ${rotate}deg`}>
    {src ? <img src={src} alt={alt} loading="lazy" /> : <span class="fallback" role="img" aria-label={alt}>{initial}</span>}
    <span class="tape" aria-hidden={tape ? undefined : 'true'}>{tape}</span>
  </span>
</span>

<style>
  .frame-wrap {
    display: block;
    width: 100%;
  }

  .frame {
    position: relative;
    display: block;
    width: 100%;
    aspect-ratio: 1;
    background: var(--white);
    border: var(--border);
    box-shadow: var(--shadow-lg);
  }

  img,
  .fallback {
    display: grid;
    place-items: center;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .fallback {
    background: var(--yellow);
    color: var(--ink);
    font-size: var(--text-display);
    font-weight: 900;
    line-height: 1;
  }

  .tape {
    position: absolute;
    top: -0.6em;
    left: -1.2em;
    min-width: 5em;
    padding: 0.3em 0.9em;
    background: var(--lime);
    border: var(--border);
    font-size: var(--text-label);
    font-weight: 700;
    line-height: 1.4;
    text-align: center;
    transform: rotate(-8deg);
  }
</style>
