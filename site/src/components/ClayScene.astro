---
/**
 * A box of real-time 3D clay objects (src/scripts/clay-scene.ts) that fills
 * its positioned parent. three.js loads only when the box nears the viewport
 * and only if WebGL is available; until then (or without it) the box is empty
 * and the page reads the same.
 */
import type { Placement } from '../scripts/clay-scene';

interface Props {
  layout: Placement[];
  class?: string;
}

const { layout, class: className } = Astro.props;
---

<div class:list={['clay', className]} data-clay={JSON.stringify(layout)} aria-hidden="true"></div>

<script>
  const boxes = document.querySelectorAll<HTMLElement>('[data-clay]');
  // WebGL with a real GPU only: software renderers (SwiftShader, llvmpipe)
  // take seconds to build the scene and would stutter, so the box stays empty.
  const gl = (() => {
    try {
      const c = document.createElement('canvas');
      const ctx = (c.getContext('webgl2') || c.getContext('webgl')) as WebGLRenderingContext | null;
      if (!ctx) return false;
      const info = ctx.getExtension('WEBGL_debug_renderer_info');
      const name = info ? String(ctx.getParameter(info.UNMASKED_RENDERER_WEBGL)) : '';
      ctx.getExtension('WEBGL_lose_context')?.loseContext();
      return !/swiftshader|llvmpipe|software|basic render/i.test(name);
    } catch {
      return false;
    }
  })();
  // The clay is decoration: start it after the page has loaded and the main
  // thread is idle, so it never competes with the headline's first paint.
  const start = (run: () => void) => {
    const idle = () => ('requestIdleCallback' in window ? requestIdleCallback(run, { timeout: 2500 }) : setTimeout(run, 200));
    if (document.readyState === 'complete') idle();
    else addEventListener('load', idle, { once: true });
  };
  if (gl && boxes.length) {
    const io = new IntersectionObserver(
      (entries) => {
        for (const e of entries) {
          if (!e.isIntersecting) continue;
          io.unobserve(e.target);
          const el = e.target as HTMLElement;
          start(() =>
            import('../scripts/clay-scene').then(({ mountClay }) => mountClay(el, JSON.parse(el.dataset.clay ?? '[]'))),
          );
        }
      },
      { rootMargin: '200px' },
    );
    boxes.forEach((b) => io.observe(b));
  }
</script>

<style>
  .clay {
    position: absolute;
    inset: 0;
    z-index: 0;
    pointer-events: none;
    opacity: 0;
    transition: opacity 600ms var(--ease);
  }
  .clay[data-ready='true'] {
    opacity: 1;
  }
  .clay :global(canvas) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    display: block;
  }
</style>
