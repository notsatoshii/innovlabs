---
/**
 * The eight icons (visual spec 4.2): 48px grid, 3px stroke, square caps and
 * joins, one fill color per icon, the rest white. One object each.
 */
export interface Props {
  name: 'worker' | 'student' | 'founder' | 'company' | 'profile' | 'knowledge' | 'community' | 'toolkit';
  class?: string;
}

const { name, class: className } = Astro.props;
---

<svg class:list={['icon', className]} viewBox="0 0 48 48" aria-hidden="true" focusable="false">
  {name === 'worker' && (
    <>
      <rect class="white" x="6" y="8" width="36" height="24" />
      <rect class="lime" x="12" y="13" width="20" height="10" />
      <path d="M24 32v8M14 40h20" />
    </>
  )}
  {name === 'student' && (
    <>
      <rect class="white" x="10" y="6" width="26" height="36" />
      <path d="M16 16h14M16 23h14M16 30h8" />
      <rect class="pink" x="32" y="12" width="9" height="9" />
    </>
  )}
  {name === 'founder' && (
    <>
      <rect class="white" x="6" y="22" width="26" height="18" />
      <rect class="white" x="11" y="15" width="26" height="18" />
      <rect class="lime" x="16" y="8" width="26" height="18" />
    </>
  )}
  {name === 'company' && (
    <>
      <rect class="yellow" x="10" y="6" width="28" height="36" />
      <rect class="white" x="16" y="12" width="6" height="6" />
      <rect class="white" x="26" y="12" width="6" height="6" />
      <rect class="white" x="16" y="22" width="6" height="6" />
      <path d="M6 42h36" />
    </>
  )}
  {name === 'profile' && (
    <>
      <rect class="lime" x="10" y="6" width="28" height="36" />
      <path d="M16 18h16M16 25h16M16 32h10" />
      <rect class="cyan" x="30" y="6" width="8" height="8" />
    </>
  )}
  {name === 'knowledge' && (
    <>
      <rect class="yellow" x="8" y="8" width="32" height="9" />
      <rect class="white" x="8" y="20" width="32" height="9" />
      <rect class="white" x="8" y="32" width="32" height="9" />
    </>
  )}
  {name === 'community' && (
    <>
      <rect class="white" x="6" y="8" width="20" height="20" />
      <rect class="white" x="22" y="20" width="20" height="20" />
      <rect class="pink" x="14" y="14" width="20" height="20" />
    </>
  )}
  {name === 'toolkit' && (
    <path class="lime" d="M30 8l10 10-6 6-4-4-14 14-6-6 14-14-4-4z" />
  )}
</svg>

<style>
  .icon {
    display: block;
    width: var(--icon);
    height: var(--icon);
    fill: none;
    stroke: var(--ink);
    stroke-width: 3;
    stroke-linecap: square;
    stroke-linejoin: miter;
  }

  .white {
    fill: var(--white);
  }
  .lime {
    fill: var(--lime);
  }
  .pink {
    fill: var(--pink);
  }
  .yellow {
    fill: var(--yellow);
  }
  .cyan {
    fill: var(--cyan);
  }

  @media (max-width: 899px) {
    .icon {
      width: 2.5rem;
      height: 2.5rem;
    }
  }
</style>
