---
/** HTML shell: meta, canonical + hreflang, favicon, font preload, nav, footer. */
import '@fontsource/black-han-sans';
import '@fontsource/barlow-condensed/latin-600.css';
import '@fontsource/barlow-condensed/latin-700.css';
import '../styles/global.css';
import { getRelativeLocaleUrl } from 'astro:i18n';
import Footer from '../components/Footer.astro';
import Nav from '../components/Nav.astro';
import { asLocale, LOCALES, stripLocale, t } from '../i18n/utils';

interface Props {
  title: string;
  description: string;
  /** Keep the page out of search indexes (stubs). */
  noindex?: boolean;
  /** The 404 page: noindex, no canonical or hreflang, language toggle to the locale homes. */
  notFound?: boolean;
}

const { title, description, noindex = false, notFound = false } = Astro.props;
const locale = asLocale(Astro.currentLocale);
const site = Astro.site;
if (!site) throw new Error('astro.config.mjs must set `site` for canonical URLs');

const pathname = Astro.url.pathname;
const localFree = stripLocale(pathname).replace(/^\//, '');
const canonical = new URL(pathname, site).href;
const alternates = LOCALES.map((code) => ({
  code,
  href: new URL(getRelativeLocaleUrl(code, localFree), site).href,
}));

// Favicon: white tile with a navy border, navy asterisk, marker-yellow centre, as an SVG data URI.
// public/favicon.ico and public/apple-touch-icon.png are the same mark,
// rasterised by scripts/make-icons.mjs.
const faviconSvg = [
  "<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 64 64'>",
  "<rect x='2' y='2' width='60' height='60' rx='6' fill='#FFFFFF' stroke='#14213D' stroke-width='4'/>",
  "<g transform='translate(32 32)' fill='#14213D'>",
  "<rect x='-5' y='-21' width='10' height='42'/>",
  "<rect x='-5' y='-21' width='10' height='42' transform='rotate(60)'/>",
  "<rect x='-5' y='-21' width='10' height='42' transform='rotate(-60)'/>",
  "<rect x='-5' y='-5' width='10' height='10' fill='#FFE14D' stroke='#14213D' stroke-width='2'/>",
  '</g></svg>',
].join('');
const favicon = `data:image/svg+xml,${encodeURIComponent(faviconSvg)}`;
const ogImage = new URL(`/og-${locale}.png`, site).href;
---

<!doctype html>
<html lang={locale}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#FBFDFF" />
    <meta name="color-scheme" content="light" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {(noindex || notFound) && <meta name="robots" content="noindex" />}
    {!notFound && <link rel="canonical" href={canonical} />}
    {!notFound && alternates.map((alt) => <link rel="alternate" hreflang={alt.code} href={alt.href} />)}
    {!notFound && <link rel="alternate" hreflang="x-default" href={alternates[0].href} />}
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={t(locale, 'meta.site_name')} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    {!notFound && <meta property="og:url" content={canonical} />}
    <meta property="og:locale" content={locale === 'ko' ? 'ko_KR' : 'en_US'} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:image" content={ogImage} />
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="icon" type="image/svg+xml" href={favicon} />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="preload" href="/fonts/PretendardVariable-latin.woff2" as="font" type="font/woff2" crossorigin />
    {locale === 'ko' && (
      <link rel="preload" href="/fonts/PretendardVariable-hangul.woff2" as="font" type="font/woff2" crossorigin />
    )}
  </head>
  <body>
    <a class="skip" href="#main">{t(locale, 'a11y.skip')}</a>
    <Nav locale={locale} langHome={notFound} />
    <main id="main">
      <slot />
    </main>
    <Footer locale={locale} />
  </body>
</html>
