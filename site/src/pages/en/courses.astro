---
import CoursesPage from '../../components/pages/CoursesPage.astro';
import Base from '../../layouts/Base.astro';
import { asLocale, t } from '../../i18n/utils';

const locale = asLocale(Astro.currentLocale);
---

<Base title={`${t(locale, 'meta.courses.title')} · ${t(locale, 'meta.site_name')}`} description={t(locale, 'meta.courses.description')}>
  <CoursesPage />
</Base>
