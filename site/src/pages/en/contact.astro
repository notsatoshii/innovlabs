---
import ContactPage from '../../components/pages/ContactPage.astro';
import Base from '../../layouts/Base.astro';
import { asLocale, t } from '../../i18n/utils';

const locale = asLocale(Astro.currentLocale);
---

<Base title={`${t(locale, 'meta.contact.title')} · ${t(locale, 'meta.site_name')}`} description={t(locale, 'meta.contact.description')}>
  <ContactPage />
</Base>
