---
import PlatformPage from '../components/pages/PlatformPage.astro';
import Base from '../layouts/Base.astro';
import { asLocale, t } from '../i18n/utils';

const locale = asLocale(Astro.currentLocale);
---

<Base title={`${t(locale, 'meta.platform.title')} · ${t(locale, 'meta.site_name')}`} description={t(locale, 'meta.platform.description')}>
  <PlatformPage />
</Base>
