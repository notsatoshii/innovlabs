# Copy to .env.local and fill in from Supabase dashboard (Settings -> API)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only (DO droplet .env, never committed, never in the browser bundle):
# SUPABASE_SECRET_KEY=

ANTHROPIC_API_KEY=

# Marketing site origin; the app header logo links here. Set on the droplet .env.
NEXT_PUBLIC_SITE_URL=
# Origins allowed to POST /api/inquiry (comma-separated).
INQUIRY_ALLOWED_ORIGINS=
