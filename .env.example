# Every variable the app reads. Copy to .env.local for local development, or
# to .env next to docker-compose.yml on the droplet. Never commit either file.
#
# BUILD = inlined into the bundle when the image is built; changing it needs
#         `docker compose up -d --build`.
# RUN   = read by the running server; changing it needs a container restart.

# --- Required ---------------------------------------------------------------

# BUILD. Supabase dashboard -> Settings -> API. The build fails when empty.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# RUN, server only (never in the browser bundle). Service role / secret key.
# Without it registration, the inquiry form, the labs, the staff pages and the
# report all answer 503, and /api/health reports the environment as broken.
SUPABASE_SECRET_KEY=

# --- Features ---------------------------------------------------------------

# RUN, server only. Claude API key for the personalized report. Set a monthly
# spend limit on this key in the Anthropic console.
ANTHROPIC_API_KEY=

# RUN. Origins allowed to POST /api/inquiry (the marketing site's form),
# comma-separated, scheme and host only. Empty = every request is refused.
# Example: https://innovlab.me,https://www.innovlab.me
INQUIRY_ALLOWED_ORIGINS=

# BUILD. Marketing site origin: header logo link and the privacy policy link
# on the consent screen. Example: https://innovlab.me
NEXT_PUBLIC_SITE_URL=

# BUILD. Set to 1 once Kakao login is configured in Supabase; anything else
# shows the Kakao button greyed out.
NEXT_PUBLIC_AUTH_KAKAO=

# BUILD. Default Q5 variant when the link has no ?q5= parameter: grid or seq.
NEXT_PUBLIC_Q5_VARIANT=

# --- Docker compose only (docker-compose.yml) --------------------------------

# Host port and bind address for the app container. Caddy proxies to
# 127.0.0.1:3100. Use APP_BIND=0.0.0.0 only for the plain-HTTP review URL.
# APP_PORT=3100
# APP_BIND=127.0.0.1

# --- Scripts only (never needed by the running app) --------------------------

# scripts/db.ts: Postgres connection string for applying migrations.
# Supabase dashboard -> Connect -> Session pooler. Local machine only.
# SUPABASE_DB_URL=
